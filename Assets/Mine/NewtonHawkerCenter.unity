  m_Script: {fileID: 11500000, guid: 8f6a6093ed4d28e418a27147323938a8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  uiRoot: {fileID: 515729286}
  includeUiRootCanvasGroup: 1
  excludeVideoGroupFromBatch: 1
  videoGroup: {fileID: 1803393990}
  videoPlayer: {fileID: 1803393991}
  dialogText: {fileID: 1844959944}
  voiceSource: {fileID: 1305460608}
  advanceKey: 1
  uiFade: 0.2
  videoFade: 0.3
  entries:
  - text: In Scene Roaming mode, you can explore the scene by swinging your arm.
      (Press A to continue)
    voice: {fileID: 8300000, guid: b7c825ffc502db343b748297780adc23, type: 3}
    videoClip: {fileID: 32900000, guid: b0c913b7d17f9b64f913cfd377c251bb, type: 3}
    showVideo: 1
    hideVideoOnEnd: 1
  - text: When you enter the interactive area of Virtual Hawkers, you can press the
      A button on your right-hand controller to interact with them. (Press A to continue)
    voice: {fileID: 8300000, guid: 7496f59a8b9d8a241a3c9add69187473, type: 3}
    videoClip: {fileID: 32900000, guid: 9d9600afc319c0d4490c5da693749512, type: 3}
    showVideo: 1
    hideVideoOnEnd: 1
  - text: On the left side of the scene, there is an AI-based agent. Press the X
      button once to ask it questions. (Press A to continue)
    voice: {fileID: 8300000, guid: 8df5ca6d2debdc947bac1324792bd460, type: 3}
    videoClip: {fileID: 32900000, guid: cb42d7fdcb7984446b5a7c20277ca7bb, type: 3}
    showVideo: 1
    hideVideoOnEnd: 1
  - text: If you want to exit the Scene Roaming mode, you can press the B button
      on your right-hand controller. (Press A to start your experience)
    voice: {fileID: 8300000, guid: 1ae13fa82e789b5468ff663419de18ab, type: 3}
    videoClip: {fileID: 32900000, guid: b92a5d978b0c78f4593e862e5abff476, type: 3}
    showVideo: 1
    hideVideoOnEnd: 1
